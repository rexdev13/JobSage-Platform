modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/jobsage-web"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["k6", "glib", "nss", "nspr", "atk", "at-spi2-atk", "at-spi2-core", "cups", "libdrm", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "libxkbcommon", "pango", "cairo", "expat", "alsa-lib", "dbus", "fontconfig", "freetype", "gdk-pixbuf", "gtk3", "mesa", "libgbm", "tesseract", "poppler-utils"]

[userenv]

[userenv.shared]
EMAIL_FROM = "noreply@jobsage.co.uk"
APP_URL = "https://jobsage.co.uk"
GOOGLE_CALENDAR_REDIRECT_URI = "https://jobsage.co.uk/api/marketer/calendar/google/oauth/callback"
ACCOUNT_DELETION_TOMBSTONE_BUCKET_ID = "replit-objstore-cb06040b-ed72-4c0c-9f5f-0a7529247177"

[userenv.production]
INTERNAL_SYNC_KEY = "dd1e3f9cbdc1ddb63409835bad58e09de58c0b73f5f0dd461cada94a6b4ae03e"
COMPANY_SITE_SCHEMA_IMPORT_ENABLED = "true"
COMPANY_SITE_REVIEWED_IMPORT_ENABLED = "true"

[userenv.development]
ENABLE_DEVELOPMENT_EXTERNAL_PROVIDERS = "true"

[objectStorage]
defaultBucketID = "replit-objstore-3694d154-80c4-44e1-a65d-b87607e9f95e"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18286
externalPort = 80

[[ports]]
localPort = 18557
externalPort = 3000
exposeLocalhost = true
