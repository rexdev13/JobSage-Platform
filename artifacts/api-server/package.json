{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch ./src/index.ts",
    "build": "tsx ./build.ts",
    "start": "node dist/index.cjs",
    "vacancy:jobs": "NODE_ENV=production node ./dist/vacancyJobs.cjs",
    "seed:test-email-vacancy": "tsx src/scripts/seedTestEmailVacancy.ts",
    "seed:k6-fixture": "NODE_ENV=development tsx src/scripts/seedK6Fixture.ts",
    "backfill:healthcare-vacancy-contacts": "tsx src/scripts/healthcareVacancyContactBackfill.ts",
    "backfill:reed-professions": "NODE_ENV=development tsx src/scripts/reedProfessionBackfill.ts",
    "backfill:additional-boards": "NODE_ENV=development tsx src/scripts/additionalBoardProfessionBackfill.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@types/multer": "^2.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "resend": "^6.9.4",
    "svix": "^1.98.0",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.27.3",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
