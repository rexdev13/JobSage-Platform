{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "chrome"
    ],
    "composite": true,
    "tsBuildInfoFile": ".tsbuildinfo/content.tsbuildinfo"
  },
  "include": [
    "src/components",
    "src/content.tsx",
    "src/lib/brand.ts",
    "src/lib/answerMemory.ts",
    "src/lib/cvAttachment.ts",
    "src/lib/env.ts",
    "src/lib/prefill.ts",
    "src/lib/pageWarnings.ts",
    "src/lib/questionDetector.ts",
    "src/lib/scraper.ts",
    "src/lib/trackerDetector.ts",
    "src/lib/trustedOrigin.ts",
    "src/lib/types.ts",
    "src/popup.tsx"
  ]
}