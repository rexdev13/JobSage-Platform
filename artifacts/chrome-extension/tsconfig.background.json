{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "chrome"
    ],
    "composite": true,
    "tsBuildInfoFile": ".tsbuildinfo/background.tsbuildinfo"
  },
  "include": [
    "src/background.ts",
    "src/lib/env.ts",
    "src/lib/keyedAsyncQueue.ts",
    "src/lib/navigationRecords.ts",
    "src/lib/trackingContext.ts",
    "src/lib/trustedOrigin.ts"
  ]
}