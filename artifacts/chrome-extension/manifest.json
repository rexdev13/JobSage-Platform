{
  "name": "JOBSAGE",
  "version": "0.2.0",
  "manifest_version": 3,
  "description": "JOBSAGE job application assistant for UK healthcare professionals.",
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
